    RewriteEngine On
    
    # ----------------------------------
    # Force HTTPS + non-WWW
    # ----------------------------------
    RewriteCond %{HTTP_HOST} !^techbirja\.com$ [OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://techbirja.com/$1 [L,R=301]
    
    
    RewriteRule ^(.*/)?index(\.html)?$ https://techbirja.com/$1 [R=301,L]

    
    # ----------------------------------
    # Remove .html extension (URL clean)
    # ----------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+)$ $1.html [L]
    
    # ----------------------------------
    # Remove .php extension (future safe)
    # ----------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L]
    
    # ----------------------------------
    # Redirect .html → clean URL
    # ----------------------------------
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
    RewriteRule ^ %1 [R=301,L]
    
    # ----------------------------------
    # Redirect .php → clean URL
    # ----------------------------------
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?]
    RewriteRule ^ %1 [R=301,L]
    
 
